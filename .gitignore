# Default: keep local training data/models off GitHub.
# Allow the public hub: README, evidence packs, EIPD/control-plane source, tests.

*

!.gitignore
!README.md
!eu_ai_act_conformity_v1.json
!gdpr_dpia_v1.json
!porto*.png

!app.py
!api_server.py
!utils/
!utils/*.py
!pages/
!pages/*.py

!requirements.txt
!requirements_streamlit.txt
!requirements-ml.txt
!run_training.py
!run_training_full.py
!run_training_quick.py
!run_production_monitor.py
!.github/
!.github/workflows/
!.github/workflows/ci.yml

# Local ML artifacts stay ignored (including quick sandbox + manifests/pickles)
models/
models/artifacts/
models/artifacts/quick/

!src/
!src/governance/
!src/governance/*.py
!src/governance/dpia_workspace/
!src/governance/dpia_workspace/**
!src/control_plane/
!src/control_plane/**
!src/models/
!src/models/*.py
!src/monitoring/
!src/monitoring/*.py
!src/data_processing/
!src/data_processing/*.py

!tests/
!tests/*.py
!tests/fixtures/
!tests/fixtures/**
!requirements_api.txt

!docs/
!docs/governance/
!docs/governance/LINE_REPORT.md

docs/governance/assessments/
docs/governance/control_plane_audit.jsonl
docs/governance/policies.json
docs/governance/approvals.json

__pycache__/
*.py[cod]
*.pyc
